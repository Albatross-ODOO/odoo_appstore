<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.KanbanRenderer" t-inherit-mode="extension">
        <xpath expr="//t[@t-foreach='this.getGroupsOrRecords()']" position="before">
            <div t-if="this.aicShowStageChips" class="o_aic_stage_chips" role="tablist" aria-label="Stages">
                <button type="button" role="tab" class="o_aic_stage_chip" t-att-class="{ o_active: this.aicStage.selected === null }"
                        t-att-aria-selected="this.aicStage.selected === null ? 'true' : 'false'"
                        t-on-click="() => this.aicPickStage(null)">All</button>
                <t t-foreach="this.aicStage.groups" t-as="st" t-key="st_index">
                    <button type="button" role="tab" class="o_aic_stage_chip" t-att-class="this.aicStageChipClass(st.value)"
                            t-att-aria-selected="this.aicStage.selected === st.value ? 'true' : 'false'"
                            t-on-click="() => this.aicPickStage(st.value)">
                        <t t-out="st.label"/> <span class="o_aic_stage_chip_count" t-out="st.count"/>
                    </button>
                </t>
            </div>
        </xpath>
    </t>
</templates>
