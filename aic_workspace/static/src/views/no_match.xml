<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="aic_workspace.NoMatch">
        <div class="o_nocontent_help o_aic_no_match">
            <i class="oi o_aic_no_match_icon" data-icon="search_off" role="img" aria-hidden="true"/>
            <p class="o_aic_no_match_title">Nothing matches your search</p>
            <p class="o_aic_no_match_terms" t-out="this.aicTerms"/>
            <p class="o_aic_no_match_text">Check the spelling, or clear the search to see the other records.</p>
            <button type="button" class="btn btn-secondary o_aic_no_match_clear" t-on-click="() => this.aicClearTyped()">Clear search</button>
        </div>
    </t>
    <t t-name="aic_workspace.ActionHelper" t-inherit="web.ActionHelper" t-inherit-mode="extension">
        <xpath expr="//div[@class='o_nocontent_help']" position="attributes">
            <attribute name="t-if">!this.aicNoMatch</attribute>
        </xpath>
        <xpath expr="//div[@class='o_nocontent_help']" position="after">
            <t t-else="" t-call="aic_workspace.NoMatch"/>
        </xpath>
    </t>
    <t t-name="aic_workspace.KanbanRendererNoMatch" t-inherit="web.KanbanRenderer" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_kanban_group_nocontent')]/div[hasclass('o_nocontent_help')]" position="attributes">
            <attribute name="t-if">!this.aicNoMatch</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_kanban_group_nocontent')]/div[hasclass('o_nocontent_help')]" position="after">
            <t t-else="" t-call="aic_workspace.NoMatch"/>
        </xpath>
    </t>
</templates>
