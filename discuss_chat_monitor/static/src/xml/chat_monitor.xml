<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="discuss_chat_monitor.ChatMonitorView">
        <div class="o_chat_monitor_container d-flex w-100 h-100">
            <!-- Left Sidebar -->
            <div class="o_chat_monitor_sidebar d-flex flex-column">
                <!-- Sidebar Header -->
                <div class="cm-sidebar-header p-3 border-bottom">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa fa-comments cm-icon-primary fs-4"/>
                            <h5 class="mb-0 fw-bold cm-title-text">Chat Monitor</h5>
                        </div>
                        <button class="btn btn-sm cm-btn-icon" t-on-click="loadSessions" title="Refresh Sessions">
                            <i class="fa fa-refresh"/>
                        </button>
                    </div>

                    <!-- Search Box -->
                    <div class="input-group input-group-sm mb-2">
                        <span class="input-group-text cm-search-icon">
                            <i class="fa fa-search"/>
                        </span>
                        <input type="text" class="form-control cm-search-input" placeholder="Search sessions or participants..." t-model="state.searchTerm" t-on-input="onSearchInput"/>
                    </div>

                    <!-- Type Filter Pills -->
                    <div class="d-flex gap-1 overflow-auto py-1 mb-2">
                        <button t-attf-class="btn btn-xs cm-pill-btn #{state.activeFilter == 'all' ? 'active' : ''}" t-on-click="() => this.onFilterChange('all')">
                            All Types
                        </button>
                        <button t-attf-class="btn btn-xs cm-pill-btn #{state.activeFilter == 'chat' ? 'active' : ''}" t-on-click="() => this.onFilterChange('chat')">
                            Direct
                        </button>
                        <button t-attf-class="btn btn-xs cm-pill-btn #{state.activeFilter == 'group' ? 'active' : ''}" t-on-click="() => this.onFilterChange('group')">
                            Group
                        </button>
                        <button t-attf-class="btn btn-xs cm-pill-btn #{state.activeFilter == 'channel' ? 'active' : ''}" t-on-click="() => this.onFilterChange('channel')">
                            Channels
                        </button>
                    </div>

                    <!-- Date Filter Bar -->
                    <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                        <span class="small cm-label-text fw-bold">
                            <i class="fa fa-calendar me-1"/> Date:
                        </span>
                        <div class="btn-group btn-group-sm" role="group">
                            <button t-attf-class="btn btn-xs cm-date-btn #{state.dateFilter == 'today' ? 'active' : ''}" t-on-click="() => this.onDateFilterChange('today')" title="Today's sessions">
                                Today
                            </button>
                            <button t-attf-class="btn btn-xs cm-date-btn #{state.dateFilter == 'yesterday' ? 'active' : ''}" t-on-click="() => this.onDateFilterChange('yesterday')" title="Yesterday's sessions">
                                Yesterday
                            </button>
                            <button t-attf-class="btn btn-xs cm-date-btn #{state.dateFilter == 'this_week' ? 'active' : ''}" t-on-click="() => this.onDateFilterChange('this_week')" title="Last 7 Days">
                                7 Days
                            </button>
                            <button t-attf-class="btn btn-xs cm-date-btn #{state.dateFilter == 'all' ? 'active' : ''}" t-on-click="() => this.onDateFilterChange('all')" title="All past sessions">
                                All
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Session List -->
                <div class="o_chat_monitor_sidebar_list flex-grow-1 overflow-auto p-2">
                    <t t-if="state.isLoadingSessions">
                        <div class="text-center py-5 cm-muted-text">
                            <i class="fa fa-circle-o-notch fa-spin fa-2x mb-2"/>
                            <div>Loading sessions...</div>
                        </div>
                    </t>
                    <t t-elif="state.sessions.length == 0">
                        <div class="text-center py-5 cm-muted-text px-3">
                            <i class="fa fa-comments-o fa-3x mb-2 opacity-50"/>
                            <h6 class="fw-bold">No chat sessions found</h6>
                            <p class="small">No active sessions found for <strong t-esc="state.dateFilter == 'today' ? 'Today' : (state.dateFilter == 'yesterday' ? 'Yesterday' : (state.dateFilter == 'this_week' ? 'Last 7 Days' : 'selected filters'))"/>. Try selecting 'All' in the date filter.</p>
                        </div>
                    </t>
                    <t t-else="">
                        <t t-foreach="state.sessions" t-as="session" t-key="session.id">
                            <div t-attf-class="cm-session-card p-3 mb-2 rounded-3 cursor-pointer d-flex align-items-center gap-3 #{state.selectedSession and state.selectedSession.id == session.id ? 'active' : ''}" t-on-click="() => this.selectSession(session)">
                                <!-- Avatar Stack -->
                                <div class="position-relative flex-shrink-0" style="width: 44px; height: 44px;">
                                    <t t-if="session.partners and session.partners.length > 0">
                                        <img t-att-src="session.partners[0].avatar" class="rounded-circle shadow-sm" style="width: 44px; height: 44px; object-fit: cover;" t-att-title="session.partners[0].name"/>
                                        <t t-if="session.partners.length > 1">
                                            <img t-att-src="session.partners[1].avatar" class="rounded-circle shadow-sm position-absolute bottom-0 end-0 border border-2 border-white" style="width: 24px; height: 24px; object-fit: cover;" t-att-title="session.partners[1].name"/>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <div class="cm-avatar-placeholder rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 44px; height: 44px;">
                                            <i class="fa fa-hashtag"/>
                                        </div>
                                    </t>
                                </div>

                                <!-- Session Metadata -->
                                <div class="flex-grow-1 min-w-0">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <h6 class="mb-0 text-truncate cm-card-title" style="max-width: 140px;" t-esc="session.name"/>
                                        <span class="cm-card-time" t-esc="session.last_message_time or ''"/>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <p class="mb-0 text-truncate cm-card-preview" style="max-width: 150px;" t-esc="session.last_message_preview or 'No messages'"/>
                                        <span t-attf-class="cm-type-badge #{session.channel_type == 'chat' ? 'badge-direct' : 'badge-group'}" t-esc="session.channel_type_label"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </t>
                </div>
            </div>

            <!-- Right Main Chat Pane -->
            <div class="o_chat_monitor_main flex-grow-1 d-flex flex-column h-100">
                <t t-if="state.selectedSession">
                    <!-- Session Chat Header -->
                    <div class="cm-main-header p-3 border-bottom d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="cm-header-icon rounded-circle d-flex align-items-center justify-content-center">
                                <i class="fa fa-comments"/>
                            </div>
                            <div>
                                <h5 class="mb-0 fw-bold cm-header-title" t-esc="state.selectedSession.name"/>
                                <div class="d-flex align-items-center gap-2 cm-header-meta">
                                    <span t-esc="state.selectedSession.message_count + ' messages'"/>
                                    <span>•</span>
                                    <div class="d-flex gap-1 align-items-center flex-wrap">
                                        <t t-if="state.selectedSession.partners">
                                            <t t-foreach="state.selectedSession.partners" t-as="p" t-key="p.id">
                                                <span class="cm-partner-tag" t-esc="p.name"/>
                                            </t>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-sm cm-refresh-btn d-flex align-items-center gap-1" t-on-click="refreshCurrentSession">
                                <i class="fa fa-refresh"/> Refresh Stream
                            </button>
                        </div>
                    </div>

                    <!-- Message Stream -->
                    <div class="o_chat_monitor_thread flex-grow-1 overflow-auto p-4" t-ref="chatThread">
                        <t t-if="state.isLoadingMessages">
                            <div class="text-center py-5 cm-muted-text">
                                <i class="fa fa-circle-o-notch fa-spin fa-2x mb-2"/>
                                <div>Loading conversation history...</div>
                            </div>
                        </t>
                        <t t-elif="state.messages.length == 0">
                            <div class="text-center py-5 cm-muted-text">
                                <i class="fa fa-comments-o fa-3x mb-3 opacity-50"/>
                                <h5>No messages recorded for this session yet.</h5>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="d-flex flex-column gap-3">
                                <t t-foreach="state.messages" t-as="msg" t-key="msg.id">
                                    <div class="cm-message-bubble d-flex gap-3 align-items-start p-2 rounded-3">
                                        <img t-att-src="msg.author_avatar" class="rounded-circle shadow-sm flex-shrink-0" style="width: 40px; height: 40px; object-fit: cover;" t-att-alt="msg.author_name"/>
                                        <div class="cm-bubble-body p-3 rounded-3 flex-grow-1" style="max-width: 85%;">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <strong class="cm-author-name me-2" t-esc="msg.author_name"/>
                                                <small class="cm-msg-date" t-esc="msg.date"/>
                                            </div>
                                            <div class="cm-message-content text-break mb-0" t-out="msg.body"/>

                                            <t t-if="msg.attachments and msg.attachments.length > 0">
                                                <div class="mt-2 pt-2 border-top d-flex flex-wrap gap-2">
                                                    <t t-foreach="msg.attachments" t-as="att" t-key="att.id">
                                                        <a t-att-href="att.url" target="_blank" class="cm-attachment-pill">
                                                            <i class="fa fa-paperclip me-1"/> <t t-esc="att.name"/>
                                                        </a>
                                                    </t>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <!-- Empty State View -->
                    <div class="d-flex flex-column align-items-center justify-content-center h-100 p-4 cm-empty-state">
                        <div class="cm-empty-icon p-4 rounded-circle mb-3">
                            <i class="fa fa-comments-o fa-4x"/>
                        </div>
                        <h4 class="fw-bold mb-2">Discuss Chat Monitor</h4>
                        <p class="text-center" style="max-width: 420px;">
                            Select a chat session from the left sidebar to view the full conversation history.
                        </p>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
