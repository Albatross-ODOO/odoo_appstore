<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="aic_workspace.LastMessage">
        <section t-ref="root" class="o_aic_last_message" t-if="this.state.msg" aria-label="Customer's last message">
            <header class="o_aic_last_message_head">
                <span class="o_aic_last_message_label">Last from the customer</span>
                <span class="o_aic_last_message_who"><t t-out="this.state.msg.author"/> · <span class="text-nowrap" t-out="this.when"/></span>
                <span class="flex-grow-1"/>
                <span t-if="this.state.msg.answered" class="o_aic_last_message_state o_answered">Answered</span>
                <span t-else="" class="o_aic_last_message_state o_waiting">Waiting for a reply</span>
            </header>
            <blockquote class="o_aic_last_message_text" t-out="this.state.msg.text"/>
            <button type="button" class="btn btn-primary btn-sm o_aic_last_message_reply" t-on-click="() => this.reply()">Reply</button>
        </section>
    </t>
</templates>
