<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- the M6 filter sheet on phones: a big "Show results" key closes the menu (Odoo's menu has none) -->
    <t t-name="aic_workspace.SearchBarMenu.sheet" t-inherit="web.SearchBarMenu" t-inherit-mode="extension">
        <xpath expr="//t[@t-set-slot='content']" position="inside">
            <div t-if="this.aicSmall" class="o_aic_search_foot">
                <button type="button" class="btn btn-primary" t-on-click="() => this.aicCloseSearch()">Show results</button>
            </div>
        </xpath>
    </t>
</templates>
