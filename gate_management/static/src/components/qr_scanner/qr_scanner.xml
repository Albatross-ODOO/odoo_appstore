<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="gate_management.GateQrScanner">
        <div class="o_gate_qr_scanner_widget">
            <t t-if="!state.isScanning">
                <div class="gd-otp" role="status" aria-live="polite">
                    <div t-foreach="tiles" t-as="t" t-key="t.i" t-attf-class="gd-t #{t.char ? 'gd-f' : ''} #{t.cur ? 'gd-cur' : ''}"><t t-esc="t.char"/></div>
                </div>
                <div class="gd-keys">
                    <button t-foreach="['1','2','3','4','5','6','7','8','9']" t-as="k" t-key="k" type="button" class="gd-key" t-on-click.prevent="() => this.key(k)"><t t-esc="k"/></button>
                    <button type="button" class="gd-key gd-soft" t-on-click.prevent="() => this.key('clr')">CLEAR</button>
                    <button type="button" class="gd-key" t-on-click.prevent="() => this.key('0')">0</button>
                    <button type="button" class="gd-key gd-soft" t-on-click.prevent="() => this.key('del')">⌫</button>
                </div>
                <div class="gd-stack gd-wedge">
                    <button type="button" class="gd-btn gd-primary gd-big" t-on-click.prevent="startScanner" t-att-disabled="state.busy"><i class="fa fa-qrcode"/> Scan QR code</button>
                    <input t-ref="wedge" type="text" placeholder="…or scan with a handheld scanner / paste the pass link" t-on-change="onWedge" t-on-keydown="onWedgeKey"/>
                    <p class="gd-hint">Verifies by itself at the 6th digit</p>
                </div>
            </t>
            <t t-else="">
                <div class="gd-view" style="max-width:420px" t-att-class="{ 'gd-mirror': state.facingMode === 'user' }">
                    <video t-ref="video" autoplay="autoplay" playsinline="playsinline" muted="muted"/>
                    <div class="gd-corner"/>
                    <div class="gd-scan"/>
                </div>
                <div class="gd-spread" style="max-width:420px;margin-top:12px">
                    <button type="button" class="gd-btn" t-on-click.prevent="switchCamera" title="Switch between back and front camera"><i class="fa fa-refresh"/> Flip · <t t-esc="otherFacingLabel"/></button>
                    <button type="button" class="gd-btn gd-bad" t-on-click.prevent="stopScanner"><i class="fa fa-times"/> Close</button>
                </div>
            </t>
            <canvas t-ref="canvas" class="d-none"/>
        </div>
    </t>
</templates>
