<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="aic_workspace.CustomerOverview">
        <div t-if="state.chips.length" class="o_aic_overview" role="list" aria-label="At a glance">
            <t t-foreach="state.chips" t-as="c" t-key="c.key">
                <button type="button" role="listitem" class="o_aic_overview_chip" t-att-class="'o_aic_tone_' + c.tone"
                        t-att-disabled="!c.action" t-on-click="() => this.open(c)">
                    <span class="o_aic_overview_label" t-out="c.label"/>
                    <b class="o_aic_overview_value" t-out="c.value"/>
                    <span t-if="c.note" class="o_aic_overview_note" t-out="c.note"/>
                </button>
            </t>
        </div>
    </t>
</templates>
