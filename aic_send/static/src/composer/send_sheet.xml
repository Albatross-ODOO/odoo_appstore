<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="aic_send.SendChannel">
        <div t-if="this.target" class="o_aic_send_channel" role="group" aria-label="Send by">
            <span class="o_aic_send_channel_lbl">Send by</span>
            <span class="o_aic_send_seg">
                <button type="button" class="o_on" aria-pressed="true"><i class="fa fa-envelope-o" aria-hidden="true"/> Email</button>
                <button type="button" aria-pressed="false" t-on-click="() => this.toWhatsapp()"><i class="fa fa-whatsapp" aria-hidden="true"/> WhatsApp</button>
            </span>
        </div>
    </t>
    <t t-name="aic_send.MailComposerAttachmentList" t-inherit="mail.MailComposerAttachmentList" t-inherit-mode="extension">
        <xpath expr="//li/button" position="before">
            <button t-if="this.aicIsPdf(file)" type="button" class="btn px-1 flex-shrink-0 o_aic_send_preview" title="Preview" aria-label="Preview"
                    t-on-click.stop="() => this.aicPreview(file)">
                <i class="fa fa-fw fa-eye"/>
            </button>
        </xpath>
    </t>
</templates>
