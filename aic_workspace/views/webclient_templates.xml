<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The installed app (PWA) in the company's brand: the window colour follows the theme and the
         iOS home-screen icon is the company logo. Odoo's values stay when Core is off or the
         company has no logo (models/ir_http.py). -->
    <template id="webclient_bootstrap_aic_app" inherit_id="web.webclient_bootstrap" name="Core installed app">
        <xpath expr="//meta[@name='theme-color']" position="attributes">
            <attribute name="t-att-content">aic_app_theme_color or '#71639e'</attribute>
        </xpath>
        <xpath expr="//link[@rel='apple-touch-icon']" position="attributes">
            <attribute name="t-att-href">aic_app_touch_icon or '/web/static/img/odoo-icon-ios.png'</attribute>
        </xpath>
    </template>

    <!-- Start-up splash (Core on only): while the web client's scripts load, the company's app icon and a slim
         progress bar on the window colour instead of a blank page; it fades out as soon as the app is on screen.
         Inline styles: it shows before any stylesheet is parsed. -->
    <template id="webclient_bootstrap_aic_splash" inherit_id="web.webclient_bootstrap" name="Core start-up splash">
        <xpath expr="//t[@t-call='web.layout']" position="inside">
            <div t-if="aic_app_theme_color" class="o_aic_splash" aria-hidden="true">
                <style>
                    .o_aic_splash { position: fixed; inset: 0; z-index: 2000; display: flex; flex-direction: column; align-items: center;
                        justify-content: center; gap: 22px; transition: opacity .25s ease, visibility 0s linear .25s; }
                    .o_aic_splash img { width: 72px; height: 72px; border-radius: 18px; box-shadow: 0 10px 30px rgba(0, 0, 0, .14); }
                    .o_aic_splash span { position: relative; width: 120px; height: 3px; border-radius: 3px; overflow: hidden; background: rgba(127, 127, 127, .22); }
                    .o_aic_splash span::after { content: ""; position: absolute; inset: 0 auto 0 0; width: 40%; border-radius: 3px;
                        background: currentColor; opacity: .55; animation: o_aic_splash_run 1.1s ease-in-out infinite; }
                    @keyframes o_aic_splash_run { from { transform: translateX(-100%); } to { transform: translateX(250%); } }
                    @media (prefers-reduced-motion: reduce) { .o_aic_splash span::after { animation: none; width: 100%; opacity: .3; } }
                    body:has(.o_action_manager) .o_aic_splash { opacity: 0; visibility: hidden; pointer-events: none; }
                </style>
                <t t-set="aic_splash_dark" t-value="color_scheme == 'dark'"/>
                <div class="o_aic_splash_ground" t-attf-style="position: fixed; inset: 0; z-index: -1; background: #{aic_app_theme_color};"/>
                <img t-att-src="aic_app_touch_icon or '/web/static/img/odoo-icon-ios.png'" alt=""/>
                <span t-attf-style="color: #{'#FFFFFF' if aic_splash_dark else '#2A1633'};"/>
            </div>
        </xpath>
    </template>

    <!-- The offline page the service worker shows: the company's icon, name and action colour. -->
    <template id="webclient_offline_aic" inherit_id="web.webclient_offline" name="Core offline page">
        <xpath expr="//t[@t-set='head']/style" position="after">
            <style t-if="aic_app_name">
                body { font-family: "Plus Jakarta Sans", -apple-system, "Segoe UI", Roboto, sans-serif; color: #2A1633; }
                .card img { width: 112px; border-radius: 26px; filter: none; box-shadow: 0 10px 30px rgba(42, 22, 51, .14); }
                .card h1 { font-weight: 800; letter-spacing: -.02em; }
                .card p { color: #5B4E46; }
                .card button { background-color: <t t-out="aic_app_action"/>; border-color: <t t-out="aic_app_action"/>;
                               color: <t t-out="aic_app_action_ink"/>; border-radius: 14px; font-weight: 700; }
            </style>
        </xpath>
        <xpath expr="//div[hasclass('card')]/img" position="attributes">
            <attribute name="t-att-alt">aic_app_name or 'Odoo logo'</attribute>
        </xpath>
        <xpath expr="//div[hasclass('card')]/p" position="replace">
            <p t-if="aic_app_name" t-out="aic_offline_text"/>
            <p t-else="">Check your network connection and come back here. Odoo will load as soon as you're back online.</p>
        </xpath>
    </template>
</odoo>
