<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="aic_workspace.StatusBarButtons" t-inherit="web.StatusBarButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-else='']" position="replace">
            <t t-else="">
                <t t-set="aicSplit" t-value="this.aicHeaderSplit"/>
                <t t-foreach="aicSplit[0]" t-as="slot" t-key="slot">
                    <t t-call-slot="{{ slot }}" />
                </t>
                <Dropdown t-if="aicSplit[1].length" menuClass="'o_aic_header_more_menu'">
                    <button class="btn btn-secondary o_aic_header_more" title="More actions" aria-label="More actions">
                        <i class="oi" data-icon="more_horiz" role="img"/>
                    </button>
                    <t t-set-slot="content">
                        <t t-foreach="aicSplit[1]" t-as="slot" t-key="slot">
                            <DropdownItem class="'o-dropdown-item-unstyled-button'">
                                <t t-call-slot="{{ slot }}" />
                            </DropdownItem>
                        </t>
                    </t>
                </Dropdown>
            </t>
        </xpath>
    </t>
</templates>
