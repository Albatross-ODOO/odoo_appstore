#. odoo-python
#: code:addons/eod_glass_backend_theme/engine/models/res_company.py:0
msgid ""
"“%(value)s” is not a colour. Use the #RRGGBB form, for example #FF6A2B."
msgstr ""
"«%(value)s» no es un color. Use el formato #RRGGBB, por ejemplo #FF6A2B."

#. module: eod_glass_backend_theme
#. odoo-python
#: code:addons/eod_glass_backend_theme/engine/models/res_config_settings.py:0
#, python-format
msgid "Documents and e-mails of %(company)s now use these colours."
msgstr "Los documentos y correos de %(company)s usan ahora estos colores."

#. module: eod_glass_backend_theme
#: model_terms:ir.ui.view,arch_db:eod_glass_backend_theme.res_config_settings_view_form_aic
msgid "Use on documents and e-mails"
msgstr "Usar en documentos y correos"

#. module: eod_glass_backend_theme
#: model_terms:ir.ui.view,arch_db:eod_glass_backend_theme.res_config_settings_view_form_aic
msgid ""
"Printed documents take the ink for titles and the action colour, darkened to"
" read on paper, for labels (Document Layout); e-mail buttons take the action"
" colour. These are Odoo's own settings: change them there any time."
msgstr ""
"Los documentos impresos toman la tinta para los títulos y el color de "
"acción, oscurecido para leerse en papel, para las etiquetas (Diseño de "
"documentos); los botones de los correos toman el color de acción. Son "
"ajustes propios de Odoo: cámbielos allí cuando quiera."

