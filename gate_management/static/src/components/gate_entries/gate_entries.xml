<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="gate_management.GateEntries">
        <div class="gd-app o_action">
            <div class="gd-main">
                <div class="gd-appbar">
                    <button type="button" class="gd-ico" title="Gate Desk" aria-label="Gate Desk" t-on-click="this.goHome"><i class="oi" data-icon="home"/></button>
                    <div class="gd-titlebox">
                        <h2 class="gd-title">Entries</h2>
                        <div class="gd-sub">Today · <t t-out="this.state.gate"/></div>
                    </div>
                    <div class="gd-acts">
                        <button type="button" class="gd-ico" title="Search" aria-label="Search" t-on-click="this.toggleSearch"><i class="oi" t-att-data-icon="this.state.showSearch ? 'close' : 'search'"/></button>
                    </div>
                </div>
                <div class="gd-rule"/>

                <div t-if="this.state.showSearch" class="gd-search">
                    <i class="oi" data-icon="search"/>
                    <input t-ref="this.searchRef" type="search" placeholder="Name, plate, reference, slip or scanned code…" t-att-value="this.state.term" t-on-input="this.onSearch"/>
                </div>

                <div class="gd-tabs">
                    <button t-foreach="this.filters" t-as="f" t-key="f.key" type="button" class="gd-ftab" t-att-aria-pressed="this.state.filter === f.key ? 'true' : 'false'" t-on-click="() => this.setFilter(f.key)">
                        <t t-out="f.label"/>
                        <span t-if="this.state.counts[f.key] !== undefined" class="gd-n"><t t-out="this.state.counts[f.key]"/></span>
                    </button>
                </div>

                <div class="gd-rows">
                    <div t-if="this.state.loading" class="gd-empty">Loading…</div>
                    <div t-elif="!this.state.rows.length" class="gd-empty"><t t-if="this.state.term">No entry matches "<t t-out="this.state.term"/>"</t><t t-else="">No entries here yet</t></div>
                    <div t-foreach="this.state.rows" t-as="row" t-key="row.id" t-attf-class="gd-row gd-row-compact #{this.rowClass(row)}" t-on-click="() => this.openEntry(row)" role="button">
                        <div t-attf-class="gd-av #{this.avClass(row)}">
                            <img t-if="row.has_photo" t-attf-src="/web/image?model=gate.entry&amp;id=#{row.id}&amp;field=entry_photo" alt=""/>
                            <i t-elif="row.type === 'vehicle'" class="oi" data-icon="local_shipping"/>
                            <i t-elif="row.type === 'material'" class="oi" data-icon="deployed_code"/>
                            <t t-else="" t-out="this.initials(row)"/>
                        </div>
                        <div class="gd-who">
                            <b t-att-class="row.type === 'vehicle' ? 'gd-mono' : ''"><t t-out="row.title"/></b>
                            <small><em><t t-out="row.name"/></em> · <t t-out="row.subtitle"/><t t-if="row.when"> · <t t-out="row.when"/></t></small>
                        </div>
                        <div class="gd-acts">
                            <span t-attf-class="gd-pill #{this.pillClass(row)}"><t t-out="row.overdue ? 'Overdue' : row.state_label"/></span>
                        </div>
                    </div>
                </div>
                <p class="gd-hint">Open a row for the full record with chatter, audit times and exit remarks</p>
            </div>
        </div>
    </t>
</templates>
