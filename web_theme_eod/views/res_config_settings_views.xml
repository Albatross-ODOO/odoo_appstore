<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_eod" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.web_theme_eod</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="aic_theme.res_config_settings_view_form_aic"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='aic_palette_preview']/.." position="before">
                <div class="mt-2" invisible="aic_skin != 'eod' or aic_palette_mode == 'house'">
                    <field name="aic_glass_tint"/>
                    <label for="aic_glass_tint" class="o_light_label"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
