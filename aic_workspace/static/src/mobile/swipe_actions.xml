<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- the keys a left swipe reveals on a phone card (swipe_actions.js); rendered only while open -->
    <t t-name="aic_workspace.KanbanRecord.swipe" t-inherit="web.KanbanRecord" t-inherit-mode="extension">
        <xpath expr="//article" position="inside">
            <div t-if="this.aicSwipe and this.aicSwipe.open" class="o_aic_swipe_tray" role="toolbar"
                 aria-label="Card actions" t-on-touchstart.stop="" t-on-pointerdown.stop="" t-on-click.stop="">
                <t t-foreach="this.aicSwipe.keys" t-as="key" t-key="key.id">
                    <a t-if="key.href" t-att-href="key.href" class="o_aic_swipe_key" t-att-class="'o_tone_' + key.tone"
                       t-on-click.stop="(ev) => this.aicPress(key, ev)">
                        <i class="oi" t-att-data-icon="key.icon" aria-hidden="true"/><span t-out="key.label"/>
                    </a>
                    <button t-else="" type="button" class="o_aic_swipe_key" t-att-class="'o_tone_' + key.tone"
                            t-on-click.stop="(ev) => this.aicPress(key, ev)">
                        <i class="oi" t-att-data-icon="key.icon" aria-hidden="true"/><span t-out="key.label"/>
                    </button>
                </t>
            </div>
        </xpath>
    </t>
    <!-- list rows: wrap Odoo's own touch handlers (the long press that selects rows keeps working) and
         add the tray as an absolutely placed cell while a row is open -->
    <t t-name="aic_workspace.ListRenderer.RecordRow.swipe" t-inherit="web.ListRenderer.RecordRow" t-inherit-mode="extension">
        <xpath expr="//tr[hasclass('o_data_row')]" position="attributes">
            <attribute name="t-on-touchstart">(ev) => this.aicRowTouchStart(record, ev)</attribute>
            <attribute name="t-on-touchend">() => this.aicRowTouchEnd(record)</attribute>
            <attribute name="t-on-touchmove">(ev) => this.aicRowTouchMove(record, ev)</attribute>
        </xpath>
        <xpath expr="//tr[hasclass('o_data_row')]" position="inside">
            <td t-if="this.aicRowSwipe and this.aicRowSwipe.open === record.id" class="o_aic_swipe_tray o_aic_row_tray"
                role="toolbar" aria-label="Row actions" t-on-touchstart.stop="" t-on-pointerdown.stop="" t-on-click.stop="">
                <t t-foreach="this.aicRowSwipe.keys" t-as="key" t-key="key.id">
                    <a t-if="key.href" t-att-href="key.href" class="o_aic_swipe_key" t-att-class="'o_tone_' + key.tone"
                       t-on-click.stop="(ev) => this.aicRowPress(record, key, ev)">
                        <i class="oi" t-att-data-icon="key.icon" aria-hidden="true"/><span t-out="key.label"/>
                    </a>
                    <button t-else="" type="button" class="o_aic_swipe_key" t-att-class="'o_tone_' + key.tone"
                            t-on-click.stop="(ev) => this.aicRowPress(record, key, ev)">
                        <i class="oi" t-att-data-icon="key.icon" aria-hidden="true"/><span t-out="key.label"/>
                    </button>
                </t>
            </td>
        </xpath>
    </t>
</templates>
