<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Module Category -->
        <record id="module_category_discuss_chat_monitor" model="ir.module.category">
            <field name="name">Discuss Chat Monitor</field>
            <field name="description">Security group to access chat monitoring and employee discussion logs.</field>
            <field name="sequence">25</field>
        </record>

        <!-- Privilege (Odoo 19) -->
        <record id="res_groups_privilege_discuss_chat_monitor" model="res.groups.privilege">
            <field name="name">Discuss Chat Monitor</field>
            <field name="sequence">25</field>
            <field name="category_id" ref="module_category_discuss_chat_monitor"/>
        </record>

        <!-- Security Group: Chat Monitor Manager / Admin -->
        <record id="group_chat_monitor_admin" model="res.groups">
            <field name="name">Chat Monitor Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_discuss_chat_monitor"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Authorized users with permission to monitor, view, search, and audit all employee chat sessions in Discuss.</field>
        </record>

        <!-- Record Rules -->

        <!-- No rule on discuss.channel / discuss.channel.member: monitors get no ORM access to
             conversations they are not part of (that would let them post into other people's chats
             and join restricted channels). The console reads everything through the group-checked
             RPCs of discuss.channel and the /discuss_chat_monitor/attachment/<id> route. -->

        <!-- Discuss Chat Session Rules -->
        <record id="rule_discuss_chat_session_admin" model="ir.rule">
            <field name="name">Discuss Chat Session: Admin Access</field>
            <field name="model_id" ref="model_discuss_chat_session"/>
            <field name="groups" eval="[(4, ref('group_chat_monitor_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>
