<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="aic_workspace.RecordCommand">
        <div class="o_command_default o_aic_record_command d-flex align-items-center gap-3 px-4 py-2 cursor-pointer">
            <span class="o_aic_record_kind" t-out="this.props.kind"/>
            <span class="o_aic_record_text d-flex flex-column min-w-0 flex-grow-1">
                <span class="o_command_name text-ellipsis" t-att-title="this.props.title" t-out="this.props.title"/>
                <small t-if="this.props.hint" class="o_aic_record_hint text-truncate" t-out="this.props.hint"/>
            </span>
            <t t-slot="focusMessage"/>
        </div>
    </t>
</templates>
