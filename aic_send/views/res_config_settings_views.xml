<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_aic_send" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.aic_send</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="aic_theme.res_config_settings_view_form_aic"/>
        <field name="arch" type="xml">
            <block name="theme_aic_block" position="inside">
                <setting id="aic_whatsapp_share_setting" string="Share on WhatsApp"
                         help="A WhatsApp button in the chatter of every record: the contact's number, a ready message and, for quotations, invoices and purchase orders, a secure link to the document. Reload the page after changing.">
                    <field name="aic_whatsapp_share"/>
                </setting>
            </block>
        </field>
    </record>
</odoo>
