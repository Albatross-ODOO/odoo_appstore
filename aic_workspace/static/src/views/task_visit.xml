<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="aic_workspace.TaskVisit">
        <section t-if="this.state.visit" class="o_aic_visit" aria-label="Visit">
            <div class="o_aic_visit_main">
                <b class="o_aic_visit_who" t-out="this.state.visit.customer"/>
                <span t-if="this.state.visit.address" class="o_aic_visit_where" t-out="this.state.visit.address"/>
                <span class="o_aic_visit_meta">
                    <t t-if="this.deadline"><span t-att-class="{ o_aic_visit_late: this.late }" t-out="this.deadline"/></t>
                    <t t-if="this.subtasks"><span t-out="this.subtasks"/></t>
                </span>
            </div>
            <div class="o_aic_visit_keys">
                <a t-if="this.state.visit.tel" class="btn btn-secondary" t-att-href="this.state.visit.tel"><i class="oi" data-icon="phone" aria-hidden="true"/> Call</a>
                <a t-if="this.state.visit.map" class="btn btn-secondary" t-att-href="this.state.visit.map" target="_blank" rel="noopener noreferrer"><i class="oi" data-icon="map" aria-hidden="true"/> Directions</a>
            </div>
        </section>
    </t>
</templates>
