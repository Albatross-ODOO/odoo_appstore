<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="aic_whatsapp_share_view_form" model="ir.ui.view">
        <field name="name">aic.whatsapp.share.form</field>
        <field name="model">aic.whatsapp.share</field>
        <field name="arch" type="xml">
            <form string="Share on WhatsApp">
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <group>
                    <field name="record_name"/>
                    <field name="partner_id" options="{'no_create': True}"/>
                    <field name="phone" placeholder="+91 98250 12345" widget="phone"/>
                </group>
                <field name="message" nolabel="1" placeholder="Your message" class="o_aic_wa_message"/>
                <div class="text-muted small mt-2" invisible="not link">
                    The message includes a secure link: the customer can open the document without logging in.
                </div>
                <div class="text-muted small mt-1">
                    WhatsApp opens in a new tab with this message ready; press Send there. The share is logged on the record.
                </div>
                <footer>
                    <button name="action_open_whatsapp" type="object" string="Open WhatsApp" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_share" model="ir.actions.act_window">
        <field name="name">Share on WhatsApp</field>
        <field name="res_model">aic.whatsapp.share</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
