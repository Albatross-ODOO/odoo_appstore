<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sign-in, sign-up and password reset (web.login_layout) in the Core look while it is on: the scope
         classes on <body> and the company's colours; static/src/scss/login.scss does the rest. -->
    <!-- priority 99: after web_enterprise's own sign-in class (it sets the same attribute), whatever the install
         order; with the look off, the page keeps the class stock Odoo gives it (aic_login['base']). -->
    <!-- With Website installed, website.login_layout (priority 20, so always before this view) has already replaced
         the web.frontend_layout call with a website.layout call: match either, or the view does not install. -->
    <template id="login_layout_aic" inherit_id="web.login_layout" name="Core sign-in pages" priority="99">
        <xpath expr="//t[@t-call='web.frontend_layout' or @t-call='website.layout']" position="before">
            <t t-set="aic_login" t-value="res_company.sudo().aic_login_theme()"/>
            <t t-set="head">
                <t t-out="head"/>
                <style t-if="aic_login['css']" id="o_aic_palette" t-out="aic_login['css']"/>
            </t>
        </xpath>
        <xpath expr="//t[@t-call='web.frontend_layout' or @t-call='website.layout']" position="attributes">
            <attribute name="body_classname.f">{{ aic_login['base'] }}{{ (' o_aic_theme o_aic_login o_aic_skin_' + aic_login['skin']) if aic_login['enabled'] else '' }}</attribute>
        </xpath>
    </template>
</odoo>
