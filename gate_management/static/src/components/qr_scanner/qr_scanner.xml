<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="gate_management.GateQrScanner">
        <div class="o_gate_qr_scanner_widget d-flex flex-column align-items-center gap-2 w-100">
            
            <!-- Standard text input for manual typing when not scanning -->
            <t t-if="!state.isScanning">
                <div class="d-flex w-100 gap-2 align-items-center flex-wrap flex-md-nowrap">
                    <input type="text" 
                           class="o_input flex-grow-1" 
                           t-att-value="props.record.data[props.name] || ''"
                           t-on-change="(ev) => props.record.update({ [props.name]: ev.target.value })"
                           placeholder="Scan QR or enter OTP code..."
                           style="font-size: 1.25rem; height: 50px; text-align: center;"/>
                    <button class="btn btn-primary px-4 d-flex align-items-center justify-content-center gap-2" 
                            style="height: 50px; min-width: 130px; font-size: 1.1rem; border-radius: 12px;" 
                            t-on-click="startScanner" 
                            type="button"
                            title="Open QR Scanner">
                        <i class="fa fa-qrcode fa-lg"/> Scan QR
                    </button>
                </div>
            </t>

            <!-- Video scanner mode -->
            <t t-if="state.isScanning">
                <div class="position-relative bg-dark rounded overflow-hidden shadow w-100" style="max-width: 450px; aspect-ratio: 4/3;">
                    <video t-ref="video" autoplay="autoplay" playsinline="playsinline" muted="muted" 
                           style="width: 100%; height: 100%; object-fit: cover; display: block;"/>
                    
                    <!-- Scanner overlay line animation -->
                    <div class="position-absolute start-0 w-100 bg-danger" 
                         style="height: 3px; top: 10%; transform: translateY(-50%); opacity: 0.8; box-shadow: 0 0 8px rgba(220, 53, 69, 0.8); animation: scanLine 2s infinite ease-in-out;"/>
                </div>
                
                <button class="btn btn-danger btn-lg w-100 py-3 mt-2" t-on-click="stopScanner" type="button" style="max-width: 450px; border-radius: 12px;">
                    <i class="fa fa-times"/> Close Scanner
                </button>
            </t>

            <canvas t-ref="canvas" class="d-none"/>
        </div>
    </t>
</templates>
