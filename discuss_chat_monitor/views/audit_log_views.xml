<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- List View: Audit Logs -->
        <record id="view_discuss_chat_audit_log_tree" model="ir.ui.view">
            <field name="name">discuss.chat.audit.log.list</field>
            <field name="model">discuss.chat.audit.log</field>
            <field name="arch" type="xml">
                <list string="Security Audit Logs" default_order="access_datetime desc" create="0" delete="0">
                    <field name="access_datetime"/>
                    <field name="user_id"/>
                    <field name="session_id"/>
                    <field name="action_type" widget="badge" decoration-info="action_type == 'view'" decoration-success="action_type == 'refresh'" decoration-warning="action_type == 'flag'"/>
                    <field name="notes"/>
                </list>
            </field>
        </record>

        <!-- Form View: Audit Log Details -->
        <record id="view_discuss_chat_audit_log_form" model="ir.ui.view">
            <field name="name">discuss.chat.audit.log.form</field>
            <field name="model">discuss.chat.audit.log</field>
            <field name="arch" type="xml">
                <form string="Audit Log Entry" create="0" edit="0" delete="0">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <i class="fa fa-shield text-primary me-2"/> Audit Entry Details
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="access_datetime" readonly="1"/>
                                <field name="user_id" readonly="1"/>
                                <field name="action_type" readonly="1" widget="badge"/>
                            </group>
                            <group>
                                <field name="session_id" readonly="1"/>
                                <field name="notes" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action: All Audit Logs -->
        <record id="action_discuss_chat_audit_log_all" model="ir.actions.act_window">
            <field name="name">Security Audit Logs</field>
            <field name="res_model">discuss.chat.audit.log</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No Security Audit Logs Recorded Yet.
                </p>
                <p>
                    Every time an Administrator views or exports an employee's chat session, an immutable audit record is logged here for security compliance.
                </p>
            </field>
        </record>

    </data>
</odoo>
