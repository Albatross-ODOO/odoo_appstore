<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gate_worker_search" model="ir.ui.view">
        <field name="name">gate.worker.search</field>
        <field name="model">gate.worker</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="worker_code"/>
                <field name="mobile"/>
                <field name="srno"/>
                <field name="employeename"/>
                <field name="employee_phone_number"/>
                <filter string="Inside" name="inside" domain="[('current_state', '=', 'inside')]"/>
                <filter string="On Break" name="on_break" domain="[('current_state', '=', 'break')]"/>
                <filter string="Outside" name="outside" domain="[('current_state', '=', 'outside')]"/>
                <separator/>
                <filter string="Active" name="active" domain="[('status', '=', 'active')]"/>
                <filter string="Permanent" name="permanent" domain="[('worker_type', '=', 'permanent')]"/>
                <filter string="Contract" name="contract" domain="[('worker_type', '=', 'contract')]"/>
                <filter string="Daily Wage" name="daily_wage" domain="[('worker_type', '=', 'daily_wage')]"/>
                <group>
                    <filter string="Current Status" name="group_current_state" context="{'group_by': 'current_state'}"/>
                    <filter string="Worker Type" name="group_worker_type" context="{'group_by': 'worker_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_gate_worker_tree" model="ir.ui.view">
        <field name="name">gate.worker.list</field>
        <field name="model">gate.worker</field>
        <field name="arch" type="xml">
            <list decoration-success="current_state == 'inside'" decoration-warning="current_state == 'break'" decoration-muted="current_state == 'outside'">
                <field name="worker_code"/>
                <field name="name"/>
                <field name="worker_type"/>
                <field name="mobile"/>
                <field name="srno" optional="hide"/>
                <field name="employeename" optional="hide"/>
                <field name="employee_phone_number" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="current_state" widget="badge" decoration-success="current_state == 'inside'" decoration-warning="current_state == 'break'" decoration-muted="current_state == 'outside'"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_gate_worker_kanban" model="ir.ui.view">
        <field name="name">gate.worker.kanban</field>
        <field name="model">gate.worker</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile gd-kanban" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="worker_code"/>
                <field name="worker_type"/>
                <field name="mobile"/>
                <field name="photo"/>
                <field name="status"/>
                <field name="current_state"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="gd-card gd-card-worker-#{record.current_state.raw_value}">
                            <div class="gd-card-av gd-av-worker">
                                <img t-if="record.photo.raw_value" t-attf-src="/web/image/gate.worker/#{record.id.raw_value}/photo" alt="Photo"/>
                                <t t-else=""><t t-esc="(record.name.raw_value || '?').charAt(0).toUpperCase()"/></t>
                            </div>
                            <div class="gd-card-body">
                                <div class="gd-card-title"><t t-esc="record.name.value"/></div>
                                <div class="gd-card-sub"><span class="gd-mono"><t t-esc="record.worker_code.value"/></span> · <t t-esc="record.worker_type.value"/><t t-if="record.mobile.raw_value"> · <t t-esc="record.mobile.value"/></t></div>
                            </div>
                            <div class="gd-card-side">
                                <field name="current_state" widget="badge" decoration-success="current_state == 'inside'" decoration-warning="current_state == 'break'" decoration-muted="current_state == 'outside'"/>
                                <t t-if="record.status.raw_value == 'active'">
                                    <button t-if="record.current_state.raw_value == 'outside'" name="action_check_in" type="object" class="gd-btn gd-green gd-lit gd-sm"><i class="fa fa-sign-in" title="sign in"/> Check-In</button>
                                    <button t-if="record.current_state.raw_value == 'inside'" name="action_start_break" type="object" class="gd-btn gd-brk gd-sm"><i class="fa fa-coffee" title="coffee"/> Break</button>
                                    <button t-if="record.current_state.raw_value == 'break'" name="action_end_break" type="object" class="gd-btn gd-amber gd-lit gd-sm"><i class="fa fa-play" title="play"/> Break over</button>
                                    <button t-if="record.current_state.raw_value != 'outside'" name="action_check_out" type="object" class="gd-btn gd-rosy gd-lit gd-sm"><i class="fa fa-sign-out" title="sign out"/> Check-Out</button>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_gate_worker_form" model="ir.ui.view">
        <field name="name">gate.worker.form</field>
        <field name="model">gate.worker</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_check_in" string="Check-In" type="object" class="oe_highlight" invisible="current_state != 'outside' or status != 'active'"/>
                    <button name="action_start_break" string="Start Break" type="object" invisible="current_state != 'inside'"/>
                    <button name="action_end_break" string="Break Over" type="object" class="oe_highlight" invisible="current_state != 'break'"/>
                    <button name="action_check_out" string="Check-Out" type="object" class="btn-danger" invisible="current_state == 'outside'"/>
                    <field name="current_state" widget="statusbar" statusbar_visible="outside,inside,break"/>
                </header>
                <sheet>
                    <field name="photo" widget="image" class="oe_avatar" options="{'size': [128, 128]}"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. John Doe"/></h1>
                        <label for="worker_code" class="oe_edit_only"/>
                        <h3><field name="worker_code" placeholder="e.g. WRK001"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="worker_type"/>
                            <field name="mobile" widget="phone"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Shift Logs" name="attendance_logs">
                            <field name="log_ids" readonly="1">
                                <list>
                                    <field name="check_in_time"/>
                                    <field name="check_out_time"/>
                                    <field name="shift_minutes" sum="Total" widget="float_time"/>
                                    <field name="break_minutes" sum="Total" widget="float_time"/>
                                    <field name="state" widget="badge" decoration-success="state == 'inside'" decoration-muted="state == 'outside'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Breaks" name="breaks">
                            <field name="break_ids" readonly="1">
                                <list>
                                    <field name="start_time"/>
                                    <field name="end_time"/>
                                    <field name="duration" sum="Total" widget="float_time"/>
                                </list>
                            </field>
                        </page>
                        <page string="Import Aliases" name="aliases" groups="base.group_no_one">
                            <group>
                                <field name="srno"/>
                                <field name="employeename"/>
                                <field name="employee_phone_number"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Logs -->
    <record id="view_gate_worker_log_tree" model="ir.ui.view">
        <field name="name">gate.worker.log.list</field>
        <field name="model">gate.worker.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="worker_id"/>
                <field name="check_in_time"/>
                <field name="check_out_time"/>
                <field name="shift_minutes" widget="float_time" sum="Total"/>
                <field name="break_minutes" widget="float_time" sum="Total"/>
                <field name="state" widget="badge" decoration-success="state == 'inside'" decoration-muted="state == 'outside'"/>
            </list>
        </field>
    </record>

    <record id="view_gate_worker_log_form" model="ir.ui.view">
        <field name="name">gate.worker.log.form</field>
        <field name="model">gate.worker.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group><field name="worker_id"/><field name="state"/></group>
                        <group><field name="check_in_time"/><field name="check_out_time"/><field name="shift_minutes" widget="float_time"/><field name="break_minutes" widget="float_time"/></group>
                    </group>
                    <field name="break_ids" readonly="1">
                        <list><field name="start_time"/><field name="end_time"/><field name="duration" widget="float_time"/></list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gate_worker_log_search" model="ir.ui.view">
        <field name="name">gate.worker.log.search</field>
        <field name="model">gate.worker.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="worker_id"/>
                <filter string="Open Shifts" name="open" domain="[('state', '=', 'inside')]"/>
                <filter string="Today" name="today" domain="[('check_in_time', '>=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <group>
                    <filter string="Worker" name="group_worker" context="{'group_by': 'worker_id'}"/>
                    <filter string="Day" name="group_day" context="{'group_by': 'check_in_time:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Breaks -->
    <record id="view_gate_worker_break_tree" model="ir.ui.view">
        <field name="name">gate.worker.break.list</field>
        <field name="model">gate.worker.break</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="worker_id"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="duration" widget="float_time" sum="Total"/>
            </list>
        </field>
    </record>
</odoo>
