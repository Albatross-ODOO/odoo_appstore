<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_gate_management_category" model="ir.module.category">
        <field name="name">Gate Management</field>
        <field name="description">Gate Desk: visitor, vehicle, material and workforce gate control.</field>
        <field name="sequence">20</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_gate">
        <field name="name">Gate Management</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="module_gate_management_category"/>
    </record>

    <record id="group_gate_guard" model="res.groups">
        <field name="name">Security Guard</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_gate"/>
        <field name="comment">Uses the Gate Desk app: walk-in entries, invitation verification, worker attendance and scheduling. No access to the back office.</field>
    </record>

    <record id="group_gate_manager" model="res.groups">
        <field name="name">Gate Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_gate"/>
        <field name="implied_ids" eval="[(4, ref('group_gate_guard'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Everything the guard can do, plus entries, workforce profiles, logs and reports in the back office.</field>
    </record>

    <data noupdate="1">
        <record id="rule_gate_entry_company" model="ir.rule">
            <field name="name">Gate Entry: multi-company</field>
            <field name="model_id" ref="model_gate_entry"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_gate_worker_company" model="ir.rule">
            <field name="name">Gate Worker: multi-company</field>
            <field name="model_id" ref="model_gate_worker"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
