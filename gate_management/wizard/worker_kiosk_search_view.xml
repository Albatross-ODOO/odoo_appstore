<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Worker Kiosk Search View -->
    <record id="view_worker_kiosk_search_form" model="ir.ui.view">
        <field name="name">worker.kiosk.search.form</field>
        <field name="model">worker.kiosk.search</field>
        <field name="arch" type="xml">
            <form string="Worker Check-in Search" create="false" edit="true" class="o_kiosk_form">
                <field name="current_state" invisible="1"/>
                <sheet class="p-3">
                    <div class="text-center mb-3">
                        <h2 class="text-primary fw-bold">Worker Attendance</h2>
                        <p class="text-muted">Select worker by Name or Mobile number to toggle status.</p>
                    </div>
                    
                    <div class="mb-4">
                        <field name="worker_id" 
                               options="{'no_create': True, 'no_open': True}" 
                               placeholder="🔎 Search Name or Mobile..." 
                               style="font-size: 1.3rem; height: 55px;"/>
                    </div>

                    <div invisible="not worker_id" class="text-center p-3 border rounded bg-light mb-3">
                        <div class="mb-3">
                            <field name="photo" widget="image" class="oe_avatar rounded-circle" options="{'size': [120, 120]}"/>
                        </div>
                        <h3 class="fw-bold mb-1"><field name="worker_id"/></h3>
                        <p class="text-muted mb-2">ID: <field name="worker_code"/> | <field name="worker_type"/></p>
                        <p class="mb-3">Mobile: <field name="mobile"/></p>
                        
                        <div class="mb-3">
                            <span class="badge rounded-pill p-2 fs-5 bg-success" invisible="current_state != 'inside'">Inside Premises</span>
                            <span class="badge rounded-pill p-2 fs-5 bg-warning" invisible="current_state != 'outside'">Outside Premises</span>
                        </div>

                        <button name="action_toggle_attendance" 
                                type="object" 
                                class="btn btn-success btn-lg w-100 py-3 fw-bold fs-4"
                                invisible="current_state != 'outside'">
                            ✅ Register Check-In
                        </button>
                        <button name="action_toggle_attendance" 
                                type="object" 
                                class="btn btn-danger btn-lg w-100 py-3 fw-bold fs-4"
                                invisible="current_state != 'inside'">
                            🚪 Register Check-Out
                        </button>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
