<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="aic_workspace.GanttRenderer.legend" t-inherit="web_gantt.GanttRenderer" t-inherit-mode="extension">
        <xpath expr="//GanttRendererControls" position="after">
            <t t-set="aicKeys" t-value="this.aicLegend"/>
            <ul t-if="aicKeys.length" class="o_aic_gantt_legend list-unstyled d-flex flex-wrap" aria-label="Legend">
                <li t-foreach="aicKeys" t-as="key" t-key="key.decoration" class="o_aic_gantt_key" t-att-class="key.decoration">
                    <span class="o_aic_gantt_key_mark" aria-hidden="true"/><t t-out="key.label"/>
                </li>
            </ul>
        </xpath>
    </t>
</templates>
