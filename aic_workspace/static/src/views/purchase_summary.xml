<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="aic_workspace.PurchaseLate">
        <section t-if="this.state.data" class="o_aic_missing o_aic_po_late" aria-label="Late from the vendor">
            <div class="d-flex align-items-start gap-2">
                <h3 class="o_aic_missing_title flex-grow-1">Late from the vendor</h3>
                <button t-if="this.state.data.can_chase" type="button" class="btn btn-sm btn-secondary o_aic_po_chase" t-on-click="() => this.chase()">Chase vendor</button>
            </div>
            <ul class="list-unstyled m-0">
                <li t-foreach="this.state.data.lines" t-as="l" t-key="l_index">
                    <b t-out="l.product"/>
                    <span class="o_aic_missing_line" t-out="this.line(l)"/>
                    <span class="o_aic_missing_when o_aic_po_days" t-out="this.late(l)"/>
                </li>
            </ul>
            <p t-if="this.state.data.sales.length" class="o_aic_po_sales">
                <span>Holds up</span>
                <t t-foreach="this.state.data.sales" t-as="s" t-key="s.id">
                    <button type="button" class="btn btn-link btn-sm p-0" t-on-click="() => this.openSale(s)"><t t-out="s.name"/> · <t t-out="s.customer"/></button>
                </t>
            </p>
        </section>
    </t>
</templates>
