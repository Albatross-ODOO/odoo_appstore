<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="aic_workspace.KeysDialog">
        <Dialog title.translate="Keyboard shortcuts" size="'md'" footer="false">
            <div class="o_aic_keys">
                <section t-foreach="this.groups" t-as="group" t-key="group_index" class="o_aic_keys_group">
                    <h6 t-out="group.title"/>
                    <dl>
                        <t t-foreach="group.keys" t-as="row" t-key="row_index">
                            <dt><t t-foreach="row[0]" t-as="key" t-key="key_index"><kbd t-out="key"/></t></dt>
                            <dd t-out="row[1]"/>
                        </t>
                    </dl>
                </section>
            </div>
        </Dialog>
    </t>
</templates>
