<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_aic_home" model="ir.ui.view">
        <field name="name">res.users.form.aic_home</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <group name="other_preferences" position="inside">
                <field name="aic_home_role" invisible="share" groups="base.group_erp_manager"/>
                <field name="aic_home_role_suggested" invisible="share or aic_home_role != 'auto'" groups="base.group_erp_manager"/>
            </group>
        </field>
    </record>
</odoo>
