<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron Job: Sync Daily Chat Sessions -->
        <record id="cron_sync_daily_chat_sessions" model="ir.cron">
            <field name="name">Discuss Chat Monitor: Sync Daily Sessions</field>
            <field name="model_id" ref="model_discuss_chat_session"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_daily_chat_sessions()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
