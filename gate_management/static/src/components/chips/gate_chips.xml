<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="gate_management.GateChips">
        <div t-if="this.props.segment" class="gd-seg" role="group">
            <button t-foreach="this.choices" t-as="c" t-key="c.value" type="button"
                    t-att-aria-pressed="c.value === this.value ? 'true' : 'false'" t-att-disabled="this.props.readonly"
                    t-on-click.prevent="() => this.select(c.value)">
                <i t-if="c.icon" class="oi" t-att-data-icon="c.icon"/> <t t-out="c.label"/>
            </button>
        </div>
        <div t-else="" class="gd-chips" role="group" t-attf-style="grid-template-columns: repeat(#{this.choices.length}, 1fr)">
            <button t-foreach="this.choices" t-as="c" t-key="c.value" type="button" class="gd-chip"
                    t-att-aria-pressed="c.value === this.value ? 'true' : 'false'" t-att-disabled="this.props.readonly"
                    t-on-click.prevent="() => this.select(c.value)">
                <i class="oi" t-att-data-icon="c.icon || 'radio_button_unchecked'"/>
                <t t-out="c.label"/>
            </button>
        </div>
    </t>
</templates>
