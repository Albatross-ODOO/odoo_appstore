<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="aic_workspace.PickingMissing">
        <section t-if="this.state.rows" class="o_aic_missing" aria-label="Still missing">
            <h3 class="o_aic_missing_title">Still missing</h3>
            <ul class="list-unstyled m-0">
                <li t-foreach="this.state.rows" t-as="row" t-key="row_index">
                    <b t-out="row.product"/>
                    <span class="o_aic_missing_line" t-out="this.line(row)"/>
                    <span t-if="row.expected" class="o_aic_missing_when" t-out="this.expected(row)"/>
                </li>
            </ul>
        </section>
    </t>
    <t t-name="aic_workspace.BackorderSummary">
        <div t-if="this.state.data" class="o_aic_backorder">
            <p class="o_aic_backorder_missing" t-out="this.missingText"/>
            <p class="o_aic_backorder_question" t-out="this.question"/>
        </div>
    </t>
    <t t-name="aic_workspace.ProductStrip">
        <div t-if="this.state.chips" class="o_aic_overview o_aic_product_strip" role="list" aria-label="Stock">
            <div t-foreach="this.state.chips" t-as="c" t-key="c.key" role="listitem" class="o_aic_overview_chip" t-att-class="'o_aic_tone_' + c.tone">
                <span class="o_aic_overview_label" t-out="c.label"/>
                <b class="o_aic_overview_value" t-out="c.value"/>
                <span class="o_aic_overview_note" t-out="c.note"/>
            </div>
        </div>
    </t>
    <t t-name="aic_workspace.MoSteps">
        <section t-if="this.state.data" class="o_aic_mo_steps" aria-label="Steps">
            <div class="o_aic_mo_steps_head"><b>Steps</b><span t-out="this.progress"/></div>
            <ol class="list-unstyled m-0">
                <li t-foreach="this.state.data.steps" t-as="s" t-key="s_index" t-att-class="'o_' + s.state">
                    <span class="o_aic_mo_step_dot" aria-hidden="true"/>
                    <span class="o_aic_mo_step_text"><b t-out="s.name"/><small><t t-out="s.where"/> · <t t-out="s.label"/></small></span>
                </li>
            </ol>
        </section>
    </t>
</templates>
