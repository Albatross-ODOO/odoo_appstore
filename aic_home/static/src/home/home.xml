<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="aic_home.Week">
    <p t-if="!this.state.week" class="o_aic_empty o_aic_card">Loading your week…</p>
    <t t-else="">
        <t t-set="w" t-value="this.state.week"/>
        <article class="o_aic_card o_aic_week_days">
            <div class="o_aic_card_head">
                <h2>My week</h2>
                <span class="flex-grow-1"/>
                <span class="o_aic_panel_sub" t-out="w.label"/>
            </div>
            <div class="o_aic_week_bars" role="img" t-att-aria-label="this.weekBarsLabel">
                <t t-foreach="w.days" t-as="d" t-key="d_index">
                    <div class="o_aic_week_day" t-att-class="{ o_today: d.is_today, o_past: d.is_past }">
                        <div class="o_aic_week_stack" t-att-title="this.dayTitle(d)">
                            <span class="o_aic_week_due" t-att-style="'height:' + this.barHeight(d.due)"/>
                            <span class="o_aic_week_done" t-att-style="'height:' + this.barHeight(d.done)"/>
                        </div>
                        <span class="o_aic_week_n" t-out="d.done"/>
                        <span class="o_aic_week_label" t-out="d.label"/>
                    </div>
                </t>
            </div>
            <div class="o_aic_week_legend">
                <span><i class="o_aic_week_key o_done"/>Done</span>
                <span><i class="o_aic_week_key o_due"/>Due that day, still open</span>
            </div>
            <div class="o_aic_week_totals">
                <div class="o_aic_week_total"><b t-out="w.done"/><span>done this week</span><small><t t-out="w.done_prev"/> last week</small></div>
                <button type="button" class="o_aic_week_total" t-on-click="() => this.openAction(w.still_due_action)">
                    <b t-out="w.still_due"/><span>still due this week</span></button>
                <button type="button" class="o_aic_week_total" t-att-class="w.overdue ? 'o_aic_tone_late' : ''" t-on-click="() => this.openAction(w.overdue_action)">
                    <b t-out="w.overdue"/><span>overdue</span></button>
            </div>
        </article>
        <article t-if="w.work.length" class="o_aic_card">
            <div class="o_aic_card_head"><h2>Work moved</h2><span class="flex-grow-1"/><span class="o_aic_panel_sub">This week · last week</span></div>
            <div class="o_aic_kpis">
                <t t-foreach="w.work" t-as="k" t-key="k.key">
                    <button type="button" class="o_aic_kpi" t-att-class="this.toneClass(k.tone)" t-on-click="() => this.openAction(k.action)">
                        <span class="o_aic_kpi_label" t-out="k.label"/>
                        <span class="o_aic_kpi_value" t-out="k.value"/>
                        <span class="o_aic_kpi_note" t-out="this.lastWeekLabel(k.prev)"/>
                    </button>
                </t>
            </div>
        </article>
        <article t-if="w.team" class="o_aic_card o_aic_week_team">
            <div class="o_aic_card_head"><h2>Your team</h2><span class="flex-grow-1"/><span class="o_aic_panel_sub">Who may need a hand. Alphabetical, not a ranking.</span></div>
            <table class="o_aic_week_table">
                <thead><tr><th scope="col">Person</th><th scope="col">Overdue</th><th scope="col">Still due</th><th scope="col">Done</th></tr></thead>
                <tbody>
                    <t t-foreach="w.team.members" t-as="m" t-key="m.id">
                        <tr>
                            <th scope="row"><span class="o_aic_week_avatar" t-out="m.initials" aria-hidden="true"/><t t-out="m.name"/></th>
                            <td><span t-att-class="m.overdue ? 'o_aic_chip ' + this.toneClass(m.tone) : ''" t-out="m.overdue"/></td>
                            <td t-out="m.due"/>
                            <td t-out="m.done"/>
                        </tr>
                    </t>
                </tbody>
            </table>
            <p t-if="w.team.more" class="o_aic_panel_text" t-out="this.teamMoreLabel"/>
        </article>
    </t>
</t>

<t t-name="aic_home.Home">
    <div class="o_action o_aic_home">
        <div t-if="this.state.loading and !this.data" class="o_aic_home_loading">
            <span class="o_aic_home_spinner" aria-hidden="true"/> Loading your day…
        </div>
        <div t-if="this.data" class="o_aic_home_grid">

            <!-- ============ left: focus, missed, today ============ -->
            <section class="o_aic_home_col o_aic_home_col_left">
                <div class="o_aic_focus">
                    <div class="o_aic_viewswitch" role="tablist" aria-label="Home view">
                        <button type="button" role="tab" t-att-aria-selected="this.state.view === 'today' ? 'true' : 'false'"
                                t-att-class="{ o_active: this.state.view === 'today' }" t-on-click="() => this.setView('today')">Today</button>
                        <button type="button" role="tab" t-att-aria-selected="this.state.view === 'week' ? 'true' : 'false'"
                                t-att-class="{ o_active: this.state.view === 'week' }" t-on-click="() => this.setView('week')">My week</button>
                    </div>
                    <span class="o_aic_focus_meta">
                        <t t-out="this.data.date_label"/> · <t t-out="this.data.role_label"/>
                        <t t-if="this.data.role_is_suggested"> (suggested)</t>
                    </span>
                    <h1 class="o_aic_focus_title"><t t-out="this.greetingLine"/></h1>
                    <p class="o_aic_focus_text" t-out="this.state.view === 'week' and this.state.week ? this.state.week.summary : this.data.summary"/>
                    <div class="o_aic_focus_actions">
                        <button t-if="this.data.queue.due" type="button" class="btn btn-primary" t-on-click="() => this.openQueue()">
                            <t t-out="this.queueLabel"/>
                        </button>
                        <button type="button" class="btn btn-secondary" t-on-click="() => this.refresh()">Refresh</button>
                    <button type="button" class="btn btn-link o_aic_cust_open" t-on-click="() => this.openCustomise()">Customise</button>
                    </div>
                </div>

                <t t-if="this.state.view === 'today'">
                <div t-if="(this.data.missed_count or this.data.team_overdue_count) and this.data.sections.missed" class="o_aic_card o_aic_missed">
                    <div class="o_aic_card_head">
                        <h2>Missed</h2>
                        <span t-if="this.data.missed_count" class="o_aic_badge o_aic_tone_late" t-out="this.data.missed_count"/>
                        <span class="flex-grow-1"/>
                        <button t-if="this.data.missed_count" type="button" class="btn btn-link btn-sm" t-att-disabled="this.state.busy"
                                t-on-click="() => this.rescheduleMissed()">Move all to today</button>
                    </div>
                    <p t-if="!this.data.missed_count" class="o_aic_empty">Nothing missed on your side.</p>
                    <div class="o_aic_rows">
                        <t t-foreach="this.data.missed" t-as="m" t-key="m.id">
                            <div class="o_aic_row">
                                <button type="button" class="o_aic_row_main" t-on-click="() => this.openRecord(m)">
                                    <b t-out="m.title"/>
                                    <span class="o_aic_row_sub" t-out="m.sub"/>
                                </button>
                                <span class="o_aic_row_note o_aic_ink_late" t-out="m.when"/>
                                <button type="button" class="o_aic_done" title="Mark as done" aria-label="Mark as done"
                                        t-att-disabled="this.state.busy" t-on-click="(ev) => this.markDone(ev, m.id)">
                                    <i class="oi" data-icon="check"/>
                                </button>
                            </div>
                        </t>
                    </div>
                    <div t-if="this.data.missed_count &gt; this.data.missed.length or this.data.team_overdue_count" class="o_aic_panel_foot">
                        <button t-if="this.data.missed_count &gt; this.data.missed.length" type="button" class="btn btn-link btn-sm"
                                t-on-click="() => this.openOverdue('mine')" t-out="this.seeAllMissedLabel"/>
                        <button t-if="this.data.team_overdue_count" type="button" class="btn btn-link btn-sm o_aic_team_overdue"
                                t-on-click="() => this.openOverdue('team')" t-out="this.teamOverdueLabel"/>
                    </div>
                </div>

                <div t-if="this.data.sections.today" class="o_aic_card o_aic_today">
                    <div class="o_aic_card_head"><h2>Today</h2></div>
                    <p t-if="!this.data.today.length" class="o_aic_empty">Nothing scheduled for today.</p>
                    <ol class="o_aic_timeline">
                        <t t-foreach="this.data.today" t-as="t" t-key="t_index">
                            <li class="o_aic_timeline_row">
                                <span class="o_aic_timeline_time" t-out="t.time"/>
                                <span class="o_aic_dot" t-att-class="this.toneClass(t.tone)"/>
                                <button type="button" class="o_aic_row_main" t-on-click="() => this.openRecord(t)">
                                    <b t-out="t.title"/>
                                    <span class="o_aic_row_sub" t-out="t.sub"/>
                                </button>
                                <button t-if="t.activity_id" type="button" class="o_aic_done" title="Mark as done" aria-label="Mark as done"
                                        t-att-disabled="this.state.busy" t-on-click="(ev) => this.markDone(ev, t.activity_id)">
                                    <i class="oi" data-icon="check"/>
                                </button>
                            </li>
                        </t>
                    </ol>
                </div>
                </t>
            </section>

            <!-- ============ middle: KPIs and role panels (Today) or the week (My week) ============ -->
            <section t-if="this.state.view === 'week'" class="o_aic_home_col o_aic_home_col_main o_aic_week" aria-live="polite">
                <t t-call="aic_home.Week"/>
            </section>
            <section t-else="" class="o_aic_home_col o_aic_home_col_main">
                <div class="o_aic_kpis">
                    <t t-foreach="this.data.kpis" t-as="k" t-key="k.key">
                        <button type="button" class="o_aic_kpi" t-att-class="this.toneClass(k.tone)" t-att-title="k.full" t-on-click="() => this.openAction(k.action)">
                            <span class="o_aic_kpi_label" t-out="k.label"/>
                            <span class="o_aic_kpi_value" t-out="k.value"/>
                            <span class="o_aic_kpi_note" t-out="k.note"/>
                        </button>
                    </t>
                </div>
                <p t-if="!this.data.panels.length" class="o_aic_empty o_aic_card">
                    <t t-if="this.data.layout.custom">Every panel is hidden. Use Customise to bring them back.</t>
                    <t t-else="">No panels for this role yet: the apps it uses are not installed, or there is nothing to show.
                    An administrator can change the Home role on the user form.</t>
                </p>
                <t t-foreach="this.data.panels" t-as="p" t-key="p.key">
                    <article class="o_aic_card o_aic_panel">
                        <div class="o_aic_card_head">
                            <h2 t-out="p.title"/>
                            <span t-if="p.badge" class="o_aic_badge" t-att-class="this.toneClass(p.tone)" t-out="p.badge"/>
                            <span class="flex-grow-1"/>
                            <span t-if="p.items.length" class="o_aic_panel_sub" t-out="p.sub"/>
                        </div>
                        <p t-if="!p.items.length and p.sub" class="o_aic_panel_text" t-out="p.sub"/>
                        <div t-if="p.items.length" class="o_aic_rows">
                            <t t-foreach="p.items" t-as="it" t-key="it.model + it.res_id">
                                <t t-if="it.approve">
                                <div class="o_aic_item_with_key">
                                <button type="button" class="o_aic_item" t-att-class="this.toneClass(it.tone)" t-on-click="() => this.openRecord(it)">
                                    <span class="o_aic_dot" t-att-class="this.toneClass(it.tone)"/>
                                    <span class="o_aic_item_main">
                                        <span class="o_aic_item_title">
                                            <b t-out="it.title"/>
                                            <span t-if="it.chip" class="o_aic_chip" t-att-class="this.toneClass(it.chip_tone)" t-out="it.chip"/>
                                        </span>
                                        <span class="o_aic_row_sub" t-out="it.sub"/>
                                    </span>
                                    <span class="o_aic_item_side">
                                        <b t-if="it.right" t-out="it.right"/>
                                        <span class="o_aic_row_note" t-att-class="'o_aic_ink_' + (it.tone or 'plain')" t-out="it.note"/>
                                    </span>
                                </button>
                                    <button type="button" class="btn btn-sm btn-secondary o_aic_item_key" t-att-disabled="this.state.busy"
                                            t-on-click="() => this.approveItem(it)">Approve</button>
                                    <button type="button" class="btn btn-sm btn-link o_aic_item_refuse" t-att-disabled="this.state.busy"
                                            t-on-click="() => this.startRefuse(it)">Refuse</button>
                                </div>
                                <form t-if="it.approve and this.state.refusing === it.model + it.res_id" class="o_aic_refuse_form"
                                      t-on-submit.prevent="() => this.refuseItem(it)">
                                    <label class="visually-hidden" t-att-for="'aic_refuse_' + it.res_id">Reason</label>
                                    <input class="o_input" t-att-id="'aic_refuse_' + it.res_id" t-att-value="this.state.refuseReason" t-on-input="(ev) => this.state.refuseReason = ev.target.value"
                                           placeholder="Why is it refused?" autocomplete="off"/>
                                    <button type="submit" class="btn btn-sm btn-secondary" t-att-disabled="this.state.busy or !this.state.refuseReason.trim()">Refuse</button>
                                    <button type="button" class="btn btn-sm btn-link" t-on-click="() => this.state.refusing = false">Cancel</button>
                                </form>
                                </t>
                                <t t-else="">
                                <button type="button" class="o_aic_item" t-att-class="this.toneClass(it.tone)" t-on-click="() => this.openRecord(it)">
                                    <span class="o_aic_dot" t-att-class="this.toneClass(it.tone)"/>
                                    <span class="o_aic_item_main">
                                        <span class="o_aic_item_title">
                                            <b t-out="it.title"/>
                                            <span t-if="it.chip" class="o_aic_chip" t-att-class="this.toneClass(it.chip_tone)" t-out="it.chip"/>
                                        </span>
                                        <span class="o_aic_row_sub" t-out="it.sub"/>
                                    </span>
                                    <span class="o_aic_item_side">
                                        <b t-if="it.right" t-out="it.right"/>
                                        <span class="o_aic_row_note" t-att-class="'o_aic_ink_' + (it.tone or 'plain')" t-out="it.note"/>
                                    </span>
                                </button>
                                </t>
                            </t>
                        </div>
                        <div t-if="p.footer or p.cleanup or p.actions" class="o_aic_panel_foot">
                            <t t-foreach="p.actions or []" t-as="a" t-key="a.method">
                                <button type="button" class="btn btn-sm" t-att-class="a.primary ? 'btn-primary' : 'btn-secondary'"
                                        t-att-disabled="this.state.busy" t-on-click="() => this.runPanelAction(a)" t-out="a.label"/>
                            </t>
                            <button t-if="p.footer" type="button" class="btn btn-link btn-sm" t-on-click="() => this.openAction(p.footer.action)" t-out="p.footer.label"/>
                            <button t-if="p.cleanup" type="button" class="btn btn-secondary btn-sm" t-on-click="() => this.openCleanup(p.cleanup)" t-out="p.cleanup.label"/>
                        </div>
                    </article>
                </t>
            </section>

            <!-- ============ right: apps ============ -->
            <aside t-if="this.data.sections.apps" class="o_aic_home_col o_aic_home_col_apps">
                <div class="o_aic_card">
                    <div class="o_aic_card_head"><h2>Your apps</h2></div>
                    <div class="o_aic_apps">
                        <t t-foreach="this.shownApps" t-as="app" t-key="app.id">
                            <t t-call="aic_home.HomeApp"/>
                        </t>
                    </div>
                    <t t-if="this.hiddenApps.length">
                        <button type="button" class="btn btn-link btn-sm o_aic_more_apps" t-att-aria-expanded="this.state.moreApps ? 'true' : 'false'"
                                t-on-click="() => this.state.moreApps = !this.state.moreApps">
                            <t t-out="this.moreAppsLabel"/> <i class="oi" t-att-data-icon="this.state.moreApps ? 'keyboard_arrow_up' : 'keyboard_arrow_down'" aria-hidden="true"/>
                        </button>
                        <div t-if="this.state.moreApps" class="o_aic_apps o_aic_apps_more">
                            <t t-foreach="this.hiddenApps" t-as="app" t-key="app.id">
                                <t t-call="aic_home.HomeApp"/>
                            </t>
                        </div>
                    </t>
                    <p class="o_aic_apps_hint">Ordered for your role. Badges count what needs you.</p>
                </div>
            </aside>
        </div>

        <!-- ============ Customise home ============ -->
        <t t-if="this.state.customise">
            <div class="o_aic_cust_scrim" t-on-click="() => this.closeCustomise()"/>
            <section class="o_aic_cust" role="dialog" aria-modal="true" aria-labelledby="o_aic_cust_title"
                     t-on-keydown="(ev) => this.onCustomiseKey(ev)">
                <span class="o_aic_cust_handle" aria-hidden="true"/>
                <header class="o_aic_cust_head">
                    <h2 id="o_aic_cust_title">Customise home</h2>
                    <span class="o_aic_cust_role" t-out="this.customiseFor"/>
                </header>
                <div class="o_aic_cust_body">
                    <t t-foreach="this.customiseGroups" t-as="g" t-key="g[0]">
                        <div t-if="this.state.customise[g[0]].length" class="o_aic_cust_group">
                            <h3 t-out="g[1]"/>
                            <t t-foreach="this.state.customise[g[0]]" t-as="row" t-key="row.key">
                                <div class="o_aic_cust_row" t-att-class="{ o_off: !row.visible }">
                                    <label class="o_aic_cust_switch form-switch">
                                        <input type="checkbox" class="form-check-input" role="switch" t-att-checked="row.visible"
                                               t-on-change="() => this.toggleBlock(row)"/>
                                        <span t-out="row.label"/>
                                    </label>
                                    <t t-if="g[0] !== 'sections'">
                                        <button type="button" class="o_aic_cust_move" t-att-disabled="row_first"
                                                t-att-aria-label="this.moveLabel(row, -1)" t-on-click="() => this.moveBlock(g[0], row_index, -1)">
                                            <i class="oi" data-icon="keyboard_arrow_up" aria-hidden="true"/>
                                        </button>
                                        <button type="button" class="o_aic_cust_move" t-att-disabled="row_last"
                                                t-att-aria-label="this.moveLabel(row, 1)" t-on-click="() => this.moveBlock(g[0], row_index, 1)">
                                            <i class="oi" data-icon="keyboard_arrow_down" aria-hidden="true"/>
                                        </button>
                                    </t>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>
                <footer class="o_aic_cust_foot">
                    <button type="button" class="btn btn-link" t-att-disabled="this.state.busy or !this.data.layout.custom"
                            t-on-click="() => this.resetCustomise()">Reset</button>
                    <span class="flex-grow-1"/>
                    <button type="button" class="btn btn-secondary" t-on-click="() => this.closeCustomise()">Cancel</button>
                    <button type="button" class="btn btn-primary" t-att-disabled="this.state.busy" t-on-click="() => this.saveCustomise()">Done</button>
                </footer>
            </section>
        </t>
    </div>
</t>

    <t t-name="aic_home.HomeApp">
        <a class="o_aic_app" href="#" t-att-data-menu-xmlid="app.xmlid" t-on-click.prevent="() => this.openApp(app)">
            <span class="o_aic_app_icon">
                <img t-if="app.icon" t-att-src="app.icon" alt=""/>
                <i t-elif="app.faIcon" class="oi" t-att-data-icon="app.faIcon.icon" t-attf-style="color: {{app.faIcon.color}};"/>
                <span t-if="app.badge" class="o_aic_app_badge" t-out="app.badge"/>
            </span>
            <span class="o_aic_app_name" t-out="app.name"/>
        </a>
    </t>
</templates>
